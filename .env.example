# Iris agent — configuration template.
# Copy to .env.local (gitignored) and fill in. NEVER commit real keys or URLs.

# ---- Gemini via AI Studio (fastest for local dev) ----
GOOGLE_API_KEY=your-aistudio-key-here
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GEMINI_MODEL=gemini-2.5-flash

# ---- Gemini via Vertex AI (optional alternative to AI Studio) ----
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# ---- Connection to the Wiserfunding MCP server (the secure tool boundary) ----
# The MCP server is a separate service that exposes the curated Wiserfunding tools.
# It is NOT part of this repository (it wraps proprietary infrastructure).
WF_MCP_URL=http://127.0.0.1:8799/mcp
WF_MCP_EDGE_KEY=your-mcp-edge-key-here

# ---- Multi-agent assessment pipeline (optional) ----
# WF_MULTI_AGENT=1
# WF_AGENT_MODEL=gemini-2.5-flash
